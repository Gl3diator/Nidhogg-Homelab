# Replace with the Nidhogg Tailscale IPv4 address.
TAILSCALE_IP=100.64.0.1

# Must match the address used to reach the Beszel hub.
BESZEL_APP_URL=http://100.64.0.1:8090

# Public Beszel agent key.
BESZEL_AGENT_KEY=replace-with-public-agent-key

# Secret. Never commit the real token.
BESZEL_AGENT_TOKEN=replace-with-secret-token
